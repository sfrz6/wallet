# ---------------------------------------------------------------------------
# محفظتي (Mahfazati) environment configuration
# Copy this file to .env.local and fill in real values. Never commit .env.local.
# ---------------------------------------------------------------------------

# PostgreSQL connection string (Neon, Supabase, or any managed Postgres).
# For Neon use the pooled connection string for the app.
# Example: postgresql://user:password@host/dbname?sslmode=require
#
# For a quick local Postgres with Docker:
#   docker run --name mahfazati-db -e POSTGRES_PASSWORD=postgres \
#     -e POSTGRES_DB=mahfazati -p 5432:5432 -d postgres:16
#   DATABASE_URL=postgresql://postgres:postgres@localhost:5432/mahfazati
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/mahfazati

# Secret used to derive session token and verification code hashing.
# Generate a strong random value for real use:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# The value below is only a local development placeholder. Replace it in production.
AUTH_SECRET=dev-only-change-me-0123456789abcdef

# Public base URL of the app (used in emails and cookie scoping).
APP_URL=http://localhost:3000

# ------------------------- Email verification (V1: OFF) ---------------------
# Email verification is DISABLED by default in V1: new sign-ups are treated as
# verified immediately and no email is sent. To require verification in V2, set
# REQUIRE_EMAIL_VERIFICATION=true and configure the email settings below.
REQUIRE_EMAIL_VERIFICATION=false

# Only needed when REQUIRE_EMAIL_VERIFICATION=true.
# Resend API key. If omitted in development with DEV_EMAIL_FALLBACK=true, the
# verification code is printed to the server console instead of emailed.
RESEND_API_KEY=

# From address for outgoing verification emails, e.g. "Mahfazati <no-reply@yourdomain.com>"
EMAIL_FROM=

# Development only: when "true", verification codes are printed to the server
# console instead of being emailed. MUST be false/unset in production.
DEV_EMAIL_FALLBACK=true
